# MongoDB Connection String (Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smarthire?retryWrites=true&w=majority

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_change_in_production

# Google Gemini API Key (Get free from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Application Settings
NEXT_PUBLIC_APP_NAME="SmartHire AI"
NEXT_PUBLIC_APP_URL=http://localhost:3000
